      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(websocket_connections_active)",
          "legendFormat": "Connections"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total Subscriptions",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(websocket_subscriptions_total)",
          "legendFormat": "Subscriptions"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Broadcast Rate (msg/s)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(websocket_broadcasts_total[1m]))",
          "legendFormat": "Broadcasts"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Heartbeat Timeouts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(websocket_heartbeat_timeouts_total)",
          "legendFormat": "Timeouts"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "WebSocket Traffic Throughput (Bytes Sent / Received)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(websocket_bytes_sent_total[1m]) / 1024",
          "legendFormat": "Sent (KB/s)"
        },
        {
          "expr": "rate(websocket_bytes_received_total[1m]) / 1024",
          "legendFormat": "Received (KB/s)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Connection & Reconnect Storms",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(websocket_connections_opened_total[1m])",
          "legendFormat": "Opened (conn/s)"
        },
        {
          "expr": "rate(websocket_connections_closed_total[1m])",
          "legendFormat": "Closed (conn/s)"
        },
        {
          "expr": "rate(websocket_reconnect_storms_total[1m])",
          "legendFormat": "Reconnect Storms"
        }
      ]
    }
