  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Operating Trips",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_trips_active)",
          "legendFormat": "Active Trips"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Trips Started Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_trip_started_total)",
          "legendFormat": "Trips Started"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Trips Completed Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_trip_completed_total)",
          "legendFormat": "Completed Trips"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Trip Failures & Expiries",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_trip_failed_total) + sum(itms_trip_expired_total)",
          "legendFormat": "Failed/Expired Trips"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Trip Lifecycle Rate (Started / Completed / Failed)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(itms_trip_started_total[5m])",
          "legendFormat": "Trip Started Rate"
        },
        {
          "expr": "rate(itms_trip_completed_total[5m])",
          "legendFormat": "Trip Completed Rate"
        },
        {
          "expr": "rate(itms_trip_failed_total[5m])",
          "legendFormat": "Trip Failed Rate"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Trip Lock Acquisition & Duration Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_trip_duration_seconds_bucket[5m])) by (le)) / 60",
          "legendFormat": "P95 Trip Duration (Minutes)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_trip_lock_acquisition_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Lock Acquisition (ms)"
        }
      ]
    }
  ],
