{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "GPS Updates Received Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(itms_gps_updates_received_total[1m]))",
          "legendFormat": "Updates/sec"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "GPS Acceptance Rate (%)",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(itms_gps_updates_accepted_total[1m])) / sum(rate(itms_gps_updates_received_total[1m]))) * 100",
          "legendFormat": "Acceptance %"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "GPS Rejections Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(itms_gps_updates_rejected_total[1m]))",
          "legendFormat": "Rejections/sec"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Active Student Tracking Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_gps_student_tracking_sessions_total)",
          "legendFormat": "Tracking Sessions"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "GPS Pipeline Ingestion vs Acceptance Rates",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(itms_gps_updates_received_total[1m])",
          "legendFormat": "Updates Received"
        },
        {
          "expr": "rate(itms_gps_updates_accepted_total[1m])",
          "legendFormat": "Updates Accepted"
        },
        {
          "expr": "rate(itms_gps_updates_rejected_total[1m])",
          "legendFormat": "Updates Rejected"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "GPS Pipeline Latency Percentiles (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(itms_gps_pipeline_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_gps_pipeline_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(itms_gps_pipeline_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
