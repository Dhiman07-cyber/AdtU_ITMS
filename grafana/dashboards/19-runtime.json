  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Next.js Server Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "nodejs_process_uptime_seconds / 3600",
          "legendFormat": "Uptime (Hours)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Cold Starts Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(nextjs_cold_starts_total)",
          "legendFormat": "Cold Starts"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "SSR P95 Duration (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nextjs_ssr_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 SSR (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Middleware P95 Duration (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nextjs_middleware_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Middleware (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Next.js Rendering & Middleware Performance",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nextjs_ssr_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "SSR P95 (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nextjs_middleware_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "Middleware P95 (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
