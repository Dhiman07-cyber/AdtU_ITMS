  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "API P99 Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(itms_api_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Database P99 Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(database_query_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "DB P99"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "WebSocket Slow Broadcasts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(websocket_slow_broadcasts_total)",
          "legendFormat": "Slow Broadcasts"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Build Version Info",
      "type": "stat",
      "targets": [
        {
          "expr": "nextjs_build_version_info",
          "legendFormat": "Build Version"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Domain Service Calls & Latency Performance",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(itms_domain_service_calls_total[1m]))",
          "legendFormat": "Service Invocation Rate"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_domain_service_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Service Duration (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Developer Diagnostics (Errors, Slow Endpoints, Loop Lag)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(itms_domain_service_failures_total[1m]))",
          "legendFormat": "Domain Service Failures"
        },
        {
          "expr": "nodejs_event_loop_delay_p99_seconds * 1000",
          "legendFormat": "Event Loop Lag P99 (ms)"
        }
      ]
    }
