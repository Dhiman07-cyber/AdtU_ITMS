{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Request Volume (req/s)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(itms_api_requests_total[1m]))",
          "legendFormat": "Requests/sec"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "P95 API Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_api_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "API Success Rate (%)",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(itms_api_requests_total{status=~\"2..\"}[1m])) / sum(rate(itms_api_requests_total[1m]))) * 100",
          "legendFormat": "Success Rate %"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Total API Errors",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_api_errors_total)",
          "legendFormat": "API Errors"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "API Request Latency Percentiles (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(itms_api_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(itms_api_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(itms_api_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "API HTTP Status Codes Breakdown",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(itms_api_requests_total{status=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success"
        },
        {
          "expr": "sum(rate(itms_api_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Client Errors"
        },
        {
          "expr": "sum(rate(itms_api_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Server Errors"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["api", "http", "latency", "errors", "itms"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "05 - API Dashboard",
  "uid": "itms-api",
  "version": 1
