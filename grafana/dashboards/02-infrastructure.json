  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "CPU Usage (User + System)",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(nodejs_process_cpu_user_seconds[1m]) + rate(nodejs_process_cpu_system_seconds[1m])",
          "legendFormat": "CPU Usage (Cores)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Resident Memory (RSS)",
      "type": "stat",
      "targets": [
        {
          "expr": "nodejs_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS (MB)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Heap Used",
      "type": "stat",
      "targets": [
        {
          "expr": "nodejs_process_heap_used_bytes / 1024 / 1024",
          "legendFormat": "Heap Used (MB)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Event Loop Lag (p95)",
      "type": "stat",
      "targets": [
        {
          "expr": "nodejs_event_loop_delay_p95_seconds * 1000",
          "legendFormat": "Event Loop Lag (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Node.js Process Memory Trends",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nodejs_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)"
        },
        {
          "expr": "nodejs_process_heap_total_bytes / 1024 / 1024",
          "legendFormat": "Heap Total (MB)"
        },
        {
          "expr": "nodejs_process_heap_used_bytes / 1024 / 1024",
          "legendFormat": "Heap Used (MB)"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Network Bandwidth (Inbound / Outbound)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(network_bytes_received_total[1m]) / 1024",
          "legendFormat": "Inbound (KB/s)"
        },
        {
          "expr": "rate(network_bytes_transmitted_total[1m]) / 1024",
          "legendFormat": "Outbound (KB/s)"
        }
      ]
    }
  ],
