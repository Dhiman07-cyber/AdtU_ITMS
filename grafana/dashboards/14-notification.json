  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Notifications Sent Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(itms_notifications_sent_total)",
          "legendFormat": "Sent"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "FCM Push Dispatches Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(firebase_fcm_dispatches_total)",
          "legendFormat": "FCM Dispatches"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "FCM Dispatch Latency (P95 ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(firebase_fcm_dispatch_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "FCM Invalid Tokens Pruned",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(firebase_fcm_invalid_tokens_total)",
          "legendFormat": "Invalid Tokens"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Notification Dispatch Throughput (msg/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(itms_notifications_sent_total[1m])",
          "legendFormat": "Internal Notifications"
        },
        {
          "expr": "rate(firebase_fcm_dispatches_total[1m])",
          "legendFormat": "FCM Push Notifications"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "FCM Token Lifecycle & Delivery Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(firebase_fcm_invalid_tokens_total[5m])",
          "legendFormat": "Invalid Tokens Pruned"
        }
      ]
    }
  ],
