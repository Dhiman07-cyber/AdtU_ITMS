  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "CPU Usage by Service Node",
      "description": "• WHAT IS THIS? CPU utilization rate across Node.js, Redis, and Database container processes.\n• HEALTHY BASELINE: Green (< 60%). Yellow (60-85%). Red (> 85%).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total[1m])) by (job, instance)",
          "legendFormat": "{{job}} - {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "red", "value": 0.85 }]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Memory Heap & RSS Allocations (MB)",
      "description": "• WHAT IS THIS? Resident Set Size (RSS) and Node.js V8 Heap RAM memory consumption.\n• HEALTHY BASELINE: RSS < 400 MB, Heap < 256 MB.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS {{job}} (MB)"
        },
        {
          "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
          "legendFormat": "Heap {{job}} (MB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 15 }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "Redis Memory & Command Ops Rate",
      "description": "• WHAT IS THIS? Redis RAM memory consumption and command execution throughput per second.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Redis Used RAM (MB)"
        },
        {
          "expr": "rate(redis_commands_total[1m])",
          "legendFormat": "Redis Commands/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 15 }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "PostgreSQL Query Throughput & Latency P95",
      "description": "• WHAT IS THIS? PostgreSQL database query rate and 95th percentile query execution time in milliseconds.\n• HEALTHY BASELINE: P95 Latency < 100 ms (Green). 100-300 ms (Yellow). > 300 ms (Red).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(database_queries_total[1m]))",
          "legendFormat": "Queries/sec"
        },
        {
          "expr": "histogram_quantile(0.95, rate(itms_db_query_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95 Latency (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 15 }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 5,
      "title": "NGINX Traffic & Upstream Routing",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total[1m]))",
          "legendFormat": "NGINX Total Requests/sec"
        },
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 15 }
        }
      }
    },
