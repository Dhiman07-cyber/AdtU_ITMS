rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // IDENTITY COLLECTIONS — CLIENT ACCESS BLOCKED (PostgreSQL is source of truth)
    // D1 Identity has been fully migrated to PostgreSQL.
    // Client-side access to these collections is blocked.
    // Admin SDK (server-side) bypasses security rules entirely.
    // ============================================================================

    match /unauthUsers/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /moderators/{moderatorId} {
      allow read, write: if false;
    }

    // ============================================================================
    // NON-IDENTITY COLLECTIONS (not yet migrated — retain authenticated access)
    // ============================================================================

    match /buses/{busId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /routes/{routeId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /activity_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /waiting_flags/{flagId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /swap_requests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /driver_swap_requests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /driver_swap_audit/{auditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /fcmTokens/{token} {
      allow read, write: if request.auth != null;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /processed_payments/{paymentId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /bus_locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /trip_sessions/{tripId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /profile_update_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /trip_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /real_time_locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /audit_failures/{failureId} {
      allow read, write: if false;
    }

    match /driver_location_updates/{updateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
