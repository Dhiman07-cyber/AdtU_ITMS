rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // MIGRATED TO SUPABASE POSTGRESQL — CLIENT ACCESS BLOCKED
    // All identity, application, fleet, tracking, notification, and payment
    // domain collections have been migrated to Supabase PostgreSQL.
    // Direct client access via Firebase Client SDK is blocked to protect quota.
    // Server-side Firebase Admin SDK bypasses these security rules automatically.
    // ============================================================================

    // Identity Collections (Migrated to Supabase Pg)
    match /unauthUsers/{userId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
    match /students/{studentId} {
      allow read, write: if false;
    }
    match /drivers/{driverId} {
      allow read, write: if false;
    }
    match /admins/{adminId} {
      allow read, write: if false;
    }
    match /moderators/{moderatorId} {
      allow read, write: if false;
    }

    // Fleet & Route Collections (Migrated to Supabase Pg)
    match /buses/{busId} {
      allow read, write: if false;
    }
    match /routes/{routeId} {
      allow read, write: if false;
    }

    // Application & Payment Collections (Migrated to Supabase Pg)
    match /applications/{applicationId} {
      allow read, write: if false;
    }
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    match /processed_payments/{paymentId} {
      allow read, write: if false;
    }
    match /profile_update_requests/{requestId} {
      allow read, write: if false;
    }

    // Realtime, Tracking & Trip Collections (Migrated to Supabase Pg)
    match /waiting_flags/{flagId} {
      allow read, write: if false;
    }
    match /bus_locations/{locationId} {
      allow read, write: if false;
    }
    match /driver_location_updates/{updateId} {
      allow read, write: if false;
    }
    match /real_time_locations/{locationId} {
      allow read, write: if false;
    }
    match /trip_sessions/{tripId} {
      allow read, write: if false;
    }
    match /trip_logs/{logId} {
      allow read, write: if false;
    }

    // Notification & FCM Collections (Migrated to Supabase Pg)
    match /notifications/{notificationId} {
      allow read, write: if false;
    }
    match /fcmTokens/{token} {
      allow read, write: if false;
    }

    // Audit & Rate Limit Collections (Migrated to Supabase Pg / Server-Side)
    match /audit_logs/{logId} {
      allow read, write: if false;
    }
    match /activity_logs/{logId} {
      allow read, write: if false;
    }
    match /audit_failures/{failureId} {
      allow read, write: if false;
    }
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ============================================================================
    // FIRESTORE EXCLUSIVE COLLECTIONS (Settings & User Feedback)
    // ============================================================================

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
