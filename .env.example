# ============================================================
# ADTU Bus Services - Environment Variables Template
# ============================================================

# ========================
# Firebase Configuration
# ========================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Server-side only - NEVER expose to client)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase FCM Push Notifications
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# ========================
# Cloudinary Configuration
# ========================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
NEXT_PUBLIC_CLOUDINARY_UPLOAD_ASSET_FOLDER=your_asset_folder
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# Supabase Configuration
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Service Role Key (Server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Direct Database Connection (Server-side only)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

# ========================
# Guwahati Map (PMTiles)
# ========================
NEXT_PUBLIC_GUWAHATI_PMTILES_URL=

# ========================
# Cron Job Security
# ========================
CRON_SECRET=generate_a_random_uuid_here

# ========================
# Razorpay Configuration
# ========================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ========================
# Email Configuration
# ========================
ADMIN_EMAIL=admin@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM="AdtU Bus Services <noreply@yourdomain.com>"
EMAIL_REPLY_TO=noreply@yourdomain.com

# ========================
# Admin Seed Script
# ========================
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_USERNAME=system-admin

# ========================
# Cryptographic Secrets
# ========================
RECEIPT_SIGNING_SECRET=generate_64_char_random_string
ENCRYPTION_SECRET_KEY=generate_64_char_random_string
SIGNING_SECRET_KEY=generate_64_char_random_string

DOCUMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
DOCUMENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RSA_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----\n"

# ========================
# Application URL (for CORS)
# ========================
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app
ADMIN_TOKEN=your_admin_id_token_or_cleanup_token

# ========================
# Google Analytics Configuration
# ========================
GA4_PROPERTY_ID=507313354
GA_PROJECT_ID=your-project-id
GA_CLIENT_EMAIL=your-ga-service-account@your-project-id.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_GA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ========================
# Environment Mode
# ========================
NODE_ENV=development

# ========================
# Feature Flags
# ========================
SEAT_RELEASE_AT_SOFT_BLOCK=false

# ========================
# WebSocket Runtime (MANDATORY)
# ========================
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WS_PRIVILEGED_TOKEN=__server__
WS_HOST=127.0.0.1

# ========================
# Health Server
# ========================
HEALTH_PORT=9090

# ========================
# Logging
# ========================
LOG_LEVEL=info

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=200
RATE_LIMIT_PER_SOCKET=60
RATE_LIMIT_WINDOW_MS=10000

# ========================
# Payload Limits
# ========================
MAX_PAYLOAD_SIZE=65536

# ========================
# Heartbeat
# ========================
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_GRACE_MS=5000

# ========================
# Performance
# ========================
SLOW_HANDLER_MS=100
BROADCAST_BATCH_SIZE=100
OFFLINE_QUEUE_MAX=500

# ========================
# Redis (optional - for horizontal scaling)
# ========================
# REDIS_URL=redis://redis:6379
