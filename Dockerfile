ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL:-https://ci.supabase.co}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY:-ci}
ENV SUPABASE_SERVICE_ROLE_KEY=ci
ENV SIGNING_SECRET_KEY=ci-signing-secret-key-placeholder-32ch
